          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Itinerary",
        "tags": [
          "itineraries"
        ]
      }
    },
    "/api/v1/itineraries/{job_id}/stream": {
