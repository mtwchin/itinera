                  "title": "Response List Saved Itineraries Api V1 Itineraries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Saved Itineraries",
        "tags": [
          "itineraries"
        ]
      },
      "post": {
        "operationId": "create_itinerary_api_v1_itineraries_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateItineraryRequest"
              }
            }
          },
          "required": true
