{
  "components": {
    "schemas": {
      "Accommodation": {
        "properties": {
          "address": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Address",
            "type": "string"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "address",
          "lat",
          "lng"
        ],
        "title": "Accommodation",
        "type": "object"
      },
      "AccommodationInfo": {
        "properties": {
          "evening_return": {
            "title": "Evening Return",
            "type": "string"
          },
          "morning_start": {
            "title": "Morning Start",
            "type": "string"
          },
          "transportation_tips": {
            "title": "Transportation Tips",
            "type": "string"
          }
        },
        "required": [
          "morning_start",
          "evening_return",
          "transportation_tips"
        ],
        "title": "AccommodationInfo",
        "type": "object"
      },
      "Activity": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "duration": {
            "title": "Duration",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "time",
          "name",
          "type",
          "duration",
          "description",
          "address",
          "coordinates"
        ],
        "title": "Activity",
        "type": "object"
      },
      "AuthTokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "access_token",
          "refresh_token",
          "expires_in",
          "refresh_expires_in"
        ],
        "title": "AuthTokenResponse",
        "type": "object"
      },
      "Coordinates": {
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "Coordinates",
        "type": "object"
      },
      "Day": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "title": "Activities",
            "type": "array"
          },
          "day": {
            "title": "Day",
            "type": "integer"
          },
          "theme": {
            "title": "Theme",
            "type": "string"
          }
        },
        "required": [
          "day",
          "theme",
          "activities"
        ],
        "title": "Day",
        "type": "object"
      },
      "GenerateItineraryRequest": {
        "properties": {
          "accommodation": {
            "$ref": "#/components/schemas/Accommodation"
          },
          "arrival_date": {
            "format": "date",
            "title": "Arrival Date",
            "type": "string"
          },
          "budget": {
            "default": "Medium",
            "enum": [
              "Low",
              "Medium",
              "High"
            ],
            "title": "Budget",
            "type": "string"
          },
          "city": {
            "maxLength": 120,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "country": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Country",
            "type": "string"
          },
          "departure_date": {
            "format": "date",
            "title": "Departure Date",
            "type": "string"
          },
          "food_preferences": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Food Preferences"
          },
          "group_size": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Group Size",
            "type": "integer"
          },
          "must_do": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Must Do"
          },
          "wake_up_time": {
            "default": "08:00",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Wake Up Time",
            "type": "string"
          }
        },
        "required": [
          "city",
          "country",
          "accommodation",
          "arrival_date",
          "departure_date",
          "group_size"
        ],
        "title": "GenerateItineraryRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Itinerary": {
        "properties": {
          "accommodation_info": {
            "$ref": "#/components/schemas/AccommodationInfo"
          },
          "estimated_budget": {
            "title": "Estimated Budget",
            "type": "string"
          },
          "itinerary": {
            "items": {
              "$ref": "#/components/schemas/Day"
            },
            "title": "Itinerary",
            "type": "array"
          },
          "tips": {
            "items": {
              "type": "string"
            },
            "title": "Tips",
            "type": "array"
          }
        },
        "required": [
          "itinerary",
          "tips",
          "accommodation_info",
          "estimated_budget"
        ],
        "title": "Itinerary",
        "type": "object"
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          },
          "stream_url": {
            "title": "Stream Url",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "stream_url",
          "status_url"
        ],
        "title": "JobAccepted",
        "type": "object"
      },
      "JobStatusResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Itinerary"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 32,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest",
        "type": "object"
      },
      "SavedItinerary": {
        "properties": {
          "arrival_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrival Date"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "departure_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Departure Date"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Itinerary"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "created_at"
        ],
        "title": "SavedItinerary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Itinera API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/guest": {
      "post": {
        "operationId": "create_guest_api_v1_auth_guest_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Guest",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh_guest_session_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Guest Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/itineraries": {
      "get": {
        "operationId": "list_saved_itineraries_api_v1_itineraries_get",
