# --- Runtime ---
ENV=dev
LOG_LEVEL=INFO

# --- LLM ---
ITINERARY_COMPOSER_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/api
# Docker worker -> Ollama running on the host machine.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_API_KEY=
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
# Optional hosted alternative. Only needed when ITINERARY_COMPOSER_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Guest auth (use a random 32+ byte secret outside local development) ---
AUTH_JWT_SECRET=dev-only-change-this-signing-secret
AUTH_JWT_ISSUER=itinera-api
AUTH_JWT_AUDIENCE=itinera-ios
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_RETRY_GRACE_SECONDS=30
ITINERARY_JOB_LEASE_SECONDS=3600
OUTBOX_REDISPATCH_INITIAL_SECONDS=300
OUTBOX_REDISPATCH_MAX_SECONDS=3600

# --- Rate limiting (per authenticated principal) ---
RATE_LIMIT_GENERATIONS_PER_WINDOW=10
RATE_LIMIT_GLOBAL_GENERATIONS_PER_WINDOW=1000
RATE_LIMIT_GUEST_SESSIONS_PER_WINDOW=20
RATE_LIMIT_GLOBAL_GUEST_SESSIONS_PER_WINDOW=5000
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Production discovery and maps ---
# Production requires TRENDS_PROVIDER=http and MAPS_PROVIDER=apple.
TRENDS_PROVIDER=synthetic
TRENDS_FEED_URL=
TRENDS_FEED_API_KEY=
MAPS_PROVIDER=synthetic
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=

# --- Development-only legacy provider adapters ---
GOOGLE_MAPS_API_KEY=
TIKTOK_API_KEY=
TIKTOK_MS_TOKEN=
YOUTUBE_API_KEY=

# --- Auth (Clerk) ---
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- Infra (overridden inside docker-compose) ---
DATABASE_URL=postgresql+asyncpg://itinera:itinera@localhost:5432/itinera
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=itinera-api
