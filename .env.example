# --- Runtime ---
ENV=dev
LOG_LEVEL=INFO
API_REQUEST_MAX_BODY_BYTES=262144
# Enable only behind an authenticated/internal scraper; production defaults off.
METRICS_ENABLED=true

# --- LLM ---
# Prototype hosted path. Keep this key only in an untracked .env or your host's
# secret manager; it must never be placed in the iOS app or committed.
ITINERARY_COMPOSER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT_SECONDS=90
# Retry once when a model response fails itinerary validation. Never set above 3.
ITINERARY_COMPOSER_MAX_ATTEMPTS=2
# Bound natural-language revision output separately from full itinerary generation.
ITINERARY_EDITOR_MAX_OUTPUT_TOKENS=8000
# Keyless local alternative: set ITINERARY_COMPOSER_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434/api
# Docker worker -> Ollama running on the host machine.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_API_KEY=
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
# Optional hosted alternative. Only needed when ITINERARY_COMPOSER_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Guest auth (use a random 32+ byte secret outside local development) ---
AUTH_JWT_SECRET=dev-only-change-this-signing-secret
AUTH_JWT_ISSUER=itinera-api
AUTH_JWT_AUDIENCE=itinera-ios
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_RETRY_GRACE_SECONDS=30
ITINERARY_JOB_SOFT_TIME_LIMIT_SECONDS=105
ITINERARY_JOB_TIME_LIMIT_SECONDS=120
ITINERARY_JOB_LEASE_COMPLETION_MARGIN_SECONDS=30
ITINERARY_JOB_LEASE_SECONDS=150
OUTBOX_REDISPATCH_INITIAL_SECONDS=15
OUTBOX_REDISPATCH_MAX_SECONDS=120

# --- Atomic admission controls ---
# This kill switch rejects only new generation work; replays and read paths
# stay available, and the API remains ready when the switch is off.
GENERATION_ADMISSION_ENABLED=true
GENERATION_DISABLED_RETRY_AFTER_SECONDS=60
# Typed 503s use this retry interval when Redis cannot prove admission.
ADMISSION_UNAVAILABLE_RETRY_AFTER_SECONDS=5
RATE_LIMIT_GENERATIONS_PER_WINDOW=10
RATE_LIMIT_GLOBAL_GENERATIONS_PER_WINDOW=1000
RATE_LIMIT_GUEST_SESSIONS_PER_WINDOW=20
RATE_LIMIT_GLOBAL_GUEST_SESSIONS_PER_WINDOW=5000
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Production discovery and maps ---
# Production requires TRENDS_PROVIDER=http and MAPS_PROVIDER=apple.
TRENDS_PROVIDER=synthetic
TRENDS_FEED_URL=
TRENDS_FEED_API_KEY=
# JSON array requested from the licensed social-discovery feed.
TRENDS_SOCIAL_PLATFORMS=["tiktok","instagram_reels"]
MAPS_PROVIDER=synthetic
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
APPLE_SIGN_IN_CLIENT_ID=

# --- Development-only legacy provider adapters ---
GOOGLE_MAPS_API_KEY=
TIKTOK_API_KEY=
TIKTOK_MS_TOKEN=
YOUTUBE_API_KEY=

# --- Auth (Clerk) ---
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- Infra (overridden inside docker-compose) ---
DATABASE_URL=postgresql+asyncpg://itinera:itinera@localhost:5432/itinera
REDIS_URL=redis://localhost:6379/0
REDIS_OPERATION_TIMEOUT_SECONDS=0.5
READINESS_CHECK_TIMEOUT_SECONDS=2
READINESS_CACHE_TTL_SECONDS=2
ITINERARY_STREAM_RECONCILE_SECONDS=2
ITINERARY_STREAM_MAX_SECONDS=300
ITINERARY_STREAM_DATABASE_TIMEOUT_SECONDS=3
# Dedicated SSE reconciliation pool. The API SQLAlchemy pool can open 10
# regular + 20 overflow connections, so this default caps one API instance at
# 10 + 20 + 10 = 40 PostgreSQL connections.
ITINERARY_STREAM_DATABASE_POOL_SIZE=10
ITINERARY_STREAM_MAX_CONNECTIONS_PER_PRINCIPAL=2
ITINERARY_STREAM_LEASE_TTL_SECONDS=30
ITINERARY_STREAM_LEASE_RENEW_SECONDS=10
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=180

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=itinera-api
