# Database Configuration
# For development, you can use SQLite:
DATABASE_URL=sqlite:///./itinera.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/itinera

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# External API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# TikTok API (optional - MVP uses mock data)
TIKTOK_API_KEY=your-tiktok-api-key-here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Settings
DEBUG=True
APP_NAME=Itinera
VERSION=1.0.0

# CORS Origins (comma-separated)
# For development:
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# For production:
# CORS_ORIGINS=https://yourdomain.com

# Itinerary Generation Settings
MAX_POIS_PER_DAY=6
MIN_POIS_PER_DAY=3
FOOD_POI_RATIO=0.3
MAX_DAILY_DISTANCE_KM=15.0

# TikTok Settings
TIKTOK_MAX_VIDEOS=50
TIKTOK_MIN_LIKES=1000

